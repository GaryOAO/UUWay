#!/usr/bin/env bash
set -Eeuo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
compiler_root="$repo_dir/build/dxvk-capture/toolchain/usr"
exec "$compiler_root/bin/x86_64-w64-mingw32-g++-posix" \
    -B "$compiler_root/lib/gcc/x86_64-w64-mingw32/13-posix/" \
    -B /usr/lib/gcc/x86_64-w64-mingw32/13-posix/ \
    -B /usr/x86_64-w64-mingw32/lib/ \
    -idirafter /usr/x86_64-w64-mingw32/include "$@"
